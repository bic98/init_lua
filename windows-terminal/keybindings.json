{
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "actions": [
    {
      "command": { "action": "moveFocus", "direction": "left" },
      "id": "User.moveFocus.left"
    },
    {
      "command": { "action": "moveFocus", "direction": "down" },
      "id": "User.moveFocus.down"
    },
    {
      "command": { "action": "moveFocus", "direction": "up" },
      "id": "User.moveFocus.up"
    },
    {
      "command": { "action": "moveFocus", "direction": "right" },
      "id": "User.moveFocus.right"
    },
    {
      "command": { "action": "swapPane", "direction": "left" },
      "id": "User.swapPane.left"
    },
    {
      "command": { "action": "swapPane", "direction": "down" },
      "id": "User.swapPane.down"
    },
    {
      "command": { "action": "swapPane", "direction": "up" },
      "id": "User.swapPane.up"
    },
    {
      "command": { "action": "swapPane", "direction": "right" },
      "id": "User.swapPane.right"
    },
    {
      "command": { "action": "resizePane", "direction": "left" },
      "id": "User.resizePane.left"
    },
    {
      "command": { "action": "resizePane", "direction": "down" },
      "id": "User.resizePane.down"
    },
    {
      "command": { "action": "resizePane", "direction": "up" },
      "id": "User.resizePane.up"
    },
    {
      "command": { "action": "resizePane", "direction": "right" },
      "id": "User.resizePane.right"
    },
    {
      "command": { "action": "splitPane", "split": "right" },
      "id": "User.splitPane.right"
    },
    {
      "command": { "action": "splitPane", "split": "down" },
      "id": "User.splitPane.down"
    },
    {
      "command": {
        "action": "splitPane",
        "split": "auto",
        "splitMode": "duplicate"
      },
      "id": "User.splitPane.duplicate"
    },
    {
      "command": "closePane",
      "id": "User.closePane"
    },
    {
      "command": "togglePaneZoom",
      "id": "User.togglePaneZoom"
    },
    {
      "command": { "action": "moveFocus", "direction": "nextInOrder" },
      "id": "User.moveFocus.next"
    },
    {
      "command": { "action": "moveFocus", "direction": "previousInOrder" },
      "id": "User.moveFocus.prev"
    },
    {
      "command": "newTab",
      "id": "User.newTab"
    },
    {
      "command": "closeTab",
      "id": "User.closeTab"
    },
    {
      "command": "nextTab",
      "id": "User.nextTab"
    },
    {
      "command": "prevTab",
      "id": "User.prevTab"
    },
    {
      "command": { "action": "renameTab" },
      "id": "User.renameTab"
    },
    {
      "command": { "action": "switchToTab", "index": 0 },
      "id": "User.tab.0"
    },
    {
      "command": { "action": "switchToTab", "index": 1 },
      "id": "User.tab.1"
    },
    {
      "command": { "action": "switchToTab", "index": 2 },
      "id": "User.tab.2"
    },
    {
      "command": { "action": "switchToTab", "index": 3 },
      "id": "User.tab.3"
    },
    {
      "command": { "action": "switchToTab", "index": 4 },
      "id": "User.tab.4"
    },
    {
      "command": { "action": "switchToTab", "index": 5 },
      "id": "User.tab.5"
    },
    {
      "command": { "action": "switchToTab", "index": 6 },
      "id": "User.tab.6"
    },
    {
      "command": { "action": "switchToTab", "index": 7 },
      "id": "User.tab.7"
    },
    {
      "command": { "action": "switchToTab", "index": 8 },
      "id": "User.tab.8"
    }
  ],
  "keybindings": [
    { "id": "User.moveFocus.left", "keys": "alt+h" },
    { "id": "User.moveFocus.down", "keys": "alt+j" },
    { "id": "User.moveFocus.up", "keys": "alt+k" },
    { "id": "User.moveFocus.right", "keys": "alt+l" },

    { "id": "User.swapPane.left", "keys": "alt+shift+h" },
    { "id": "User.swapPane.down", "keys": "alt+shift+j" },
    { "id": "User.swapPane.up", "keys": "alt+shift+k" },
    { "id": "User.swapPane.right", "keys": "alt+shift+l" },

    { "id": "User.resizePane.left", "keys": "ctrl+alt+h" },
    { "id": "User.resizePane.down", "keys": "ctrl+alt+j" },
    { "id": "User.resizePane.up", "keys": "ctrl+alt+k" },
    { "id": "User.resizePane.right", "keys": "ctrl+alt+l" },

    { "id": "User.splitPane.right", "keys": "alt+\\" },
    { "id": "User.splitPane.down", "keys": "alt+-" },
    { "id": "User.splitPane.duplicate", "keys": "alt+shift+d" },

    { "id": "User.closePane", "keys": "alt+w" },
    { "id": "User.togglePaneZoom", "keys": "alt+z" },
    { "id": "User.moveFocus.next", "keys": "alt+]" },
    { "id": "User.moveFocus.prev", "keys": "alt+[" },

    { "id": "User.newTab", "keys": "alt+c" },
    { "id": "User.closeTab", "keys": "alt+shift+w" },
    { "id": "User.nextTab", "keys": "alt+n" },
    { "id": "User.prevTab", "keys": "alt+p" },
    { "id": "User.renameTab", "keys": "alt+," },

    { "id": "User.tab.0", "keys": "alt+1" },
    { "id": "User.tab.1", "keys": "alt+2" },
    { "id": "User.tab.2", "keys": "alt+3" },
    { "id": "User.tab.3", "keys": "alt+4" },
    { "id": "User.tab.4", "keys": "alt+5" },
    { "id": "User.tab.5", "keys": "alt+6" },
    { "id": "User.tab.6", "keys": "alt+7" },
    { "id": "User.tab.7", "keys": "alt+8" },
    { "id": "User.tab.8", "keys": "alt+9" }
  ]
}
