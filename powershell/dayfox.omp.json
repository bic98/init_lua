{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "#f6f2ee",
          "background": "#2848a9",
          "properties": {
            "style": "full",
            "home_icon": " ~",
            "max_depth": 3
          },
          "template": "  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#f6f2ee",
          "background": "#396847",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ac5402{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#6e33ce{{ end }}",
            "{{ if gt .Ahead 0 }}#287980{{ end }}",
            "{{ if gt .Behind 0 }}#a5222f{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " "
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#f6f2ee",
          "background": "#287980",
          "properties": {
            "display_mode": "environment",
            "fetch_virtual_env": true
          },
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#f6f2ee",
          "background": "#a5222f",
          "template": "  {{ if .Code }}{{ .Code }}{{ end }} "
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#3d2b5a",
          "background": "transparent",
          "template": " "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#534c45",
          "properties": {
            "threshold": 500,
            "style": "austin"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#4863b6",
          "template": "  {{ .CurrentDate | date \"15:04\" }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#2848a9",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#a5222f{{ end }}"
          ],
          "template": "❯"
        }
      ]
    }
  ]
}
